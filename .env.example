# Bu dosya commit EDİLİR — gerçek .env dosyası ASLA edilmez.
#
# Kurulum:
#   cp .env.example .env
#   Gerçek değerleri parola yöneticisinden (1Password / Bitwarden) alın.
#
# Yeni bir değişken eklediğinizde bu dosyaya da DEĞERSİZ olarak ekleyin,
# yoksa diğer kişi projeyi çalıştıramaz.

# Örnek — stack seçildikten sonra gerçekleriyle değiştirilecek
APP_ENV=development
APP_URL=http://localhost:3000

# DATABASE_URL=
# API_KEY=

# YouTube Data API — OAuth ve token yönetimi (DW-21)
# Google Cloud Console → Credentials'tan indirilen client secret dosyasının yolu.
YT_CLIENT_SECRET_PATH=
# Yetkilendirme sonrası kaydedilen/refresh edilen token dosyasının yolu.
YT_TOKEN_PATH=
