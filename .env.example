# Bu dosya commit EDİLİR — gerçek .env dosyası ASLA edilmez.
#
# Kurulum:
#   cp .env.example .env
#   Gerçek değerleri parola yöneticisinden (1Password / Bitwarden) alın.
#
# Yeni bir değişken eklediğinizde bu dosyaya da DEĞERSİZ olarak ekleyin,
# yoksa diğer kişi projeyi çalıştıramaz.

# Örnek — stack seçildikten sonra gerçekleriyle değiştirilecek
APP_ENV=development
APP_URL=http://localhost:3000

# YouTube Data API anahtarı — trend toplama için (OAuth DEĞİL).
# Google Cloud Console → APIs & Services → Credentials → API key
# Ardından "Restrict key" ile YouTube Data API v3'e kısıtlayın.
YOUTUBE_API_KEY=

# Anthropic API anahtarı — konu sınıflandırması için (ytoto konu siniflandir).
# console.anthropic.com → API keys. YouTube kotasıyla ilgisi yok.
ANTHROPIC_API_KEY=

# Sınıflandırıcının sağlayıcısı: anthropic | openrouter. Boşsa eldeki
# anahtara göre seçilir (ANTHROPIC_API_KEY varsa anthropic). OpenRouter
# üretim hattıyla AYNI bakiyeyi ve aynı günlük anahtar limitini paylaşır;
# günde ~5 çağrı, Opus sınıfının ~1/20'si maliyet. (DW-138)
LLM_SAGLAYICI=
# openrouter.ai/settings/keys — MoneyPrinterTurbo config.toml'daki anahtar olabilir.
OPENROUTER_API_KEY=
# Boşsa moonshotai/kimi-k2.6 (üretim hattıyla aynı model).
OPENROUTER_MODEL=

# Notion iç entegrasyon tokenı — trend adaylarını aktarmak için
# (ytoto trend aktar). notion.so/my-integrations → New integration.
#
# ⚠️ Token yetmiyor: 📈 Trend Adayları database sayfasında ⋯ → Connections →
# entegrasyonu ekleyin. Paylaşmazsanız API 404 döner (403 değil), yani hata
# "database yok" gibi görünür.
NOTION_TOKEN=

# 📈 Trend Adayları database kimliği. Database URL'indeki 32 karakterlik
# kısım — https://notion.so/<workspace>/<BU_KISIM>?v=…
NOTION_TREND_DB=

# Yerel durum dizini (kota defteri, trend zaman serisi, günlükler).
# Boş bırakılırsa çalışma dizinindeki `veri/` kullanılır. Git'e girmez.
YT_OTOMASYON_VERI=

# --- Zamanlanmış koşum yolları (ADR-0008) ---------------------------------
#
# Bunları normalde ELLE DOLDURMAYIN. `scripts/zamanlama-kur.sh` doğru değerleri
# plist'e basıyor; buradaki satırlar yalnızca değişkenlerin ne işe yaradığını
# belgeliyor ve elle koşum için geçersiz kılmaya yarıyor.
#
# ⚠️ Boş bırakmak güvenli: `scripts/ortak.sh` `.env`'i kaynaklarken ortamdan
# gelen dolu değerleri saklayıp geri koyuyor, yani buradaki boş değer
# `launchd`'ın verdiği yolu ezmiyor. Bu koruma olmadan depo yanlış dizine
# yazılıyor ve iki ayrı veritabanı sessizce oluşuyordu.

# Kod kökü — zamanlanmış işin koştuğu worktree. Betikler bunu okuyor.
YT_OTOMASYON_KOK=

# `zamanlama-kur.sh`'ın worktree'yi kuracağı yer.
# Boşsa: ~/.yt-otomasyon/calisan
YT_OTOMASYON_CALISMA=

# Zamanlanmış koşumun okuyacağı `.env` dosyasının tam yolu.
# Boşsa: kod kökündeki `.env`. Worktree'de `.env` olmadığı için
# `zamanlama-kur.sh` buraya geliştirme ağacının `.env`'ini yazıyor.
YT_OTOMASYON_ENV=

# Günlük dizini. Boşsa: <veri dizini>/gunluk
YT_OTOMASYON_GUNLUK=

# Sondaj bütçesinin harcandığı yayın pazarları, virgülle (DW-53).
# Boşsa: en,es — radar (okunma toplama) her koşulda tüm dillerde sürer.
YT_HEDEF_PAZARLAR=

# TikTok trend terimleri — satır başına bir terim/hashtag (DW-56).
# Ücretsiz TikTok API'si yok (Creative Center 40101 "no permission" döndürüyor,
# sayfa boş SPA kabuğu); terimler elle besleniyor. Dosya yoksa kaynak atlanır.
YT_TIKTOK_DOSYA=

# YouTube arama önerisi tohumları — satır başına bir önek, `//` yorum (DW-111).
# Boşsa pazar başına yerleşik tarih/bilim tohumları kullanılır; dosya verilirse
# varsayılanların **yerine** geçer. Kanal nişi değiştiğinde kod değişmesin diye.
YT_ONERI_TOHUM=

# DATABASE_URL=
# API_KEY=

# YouTube Data API — OAuth ve token yönetimi (DW-21)
# Google Cloud Console → Credentials'tan indirilen client secret dosyasının yolu.
YT_CLIENT_SECRET_PATH=
# Yetkilendirme sonrası kaydedilen/refresh edilen token dosyasının yolu.
YT_TOKEN_PATH=
