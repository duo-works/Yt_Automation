# Bu dosya commit EDİLİR — gerçek .env dosyası ASLA edilmez.
#
# Kurulum:
#   cp .env.example .env
#   Gerçek değerleri parola yöneticisinden (1Password / Bitwarden) alın.
#
# Yeni bir değişken eklediğinizde bu dosyaya da DEĞERSİZ olarak ekleyin,
# yoksa diğer kişi projeyi çalıştıramaz.

# Örnek — stack seçildikten sonra gerçekleriyle değiştirilecek
APP_ENV=development
APP_URL=http://localhost:3000

# YouTube Data API anahtarı — trend toplama için (OAuth DEĞİL).
# Google Cloud Console → APIs & Services → Credentials → API key
# Ardından "Restrict key" ile YouTube Data API v3'e kısıtlayın.
YOUTUBE_API_KEY=

# Anthropic API anahtarı — konu sınıflandırması için (ytoto konu siniflandir).
# console.anthropic.com → API keys. YouTube kotasıyla ilgisi yok.
ANTHROPIC_API_KEY=

# Notion iç entegrasyon tokenı — trend adaylarını aktarmak için
# (ytoto trend aktar). notion.so/my-integrations → New integration.
#
# ⚠️ Token yetmiyor: 📈 Trend Adayları database sayfasında ⋯ → Connections →
# entegrasyonu ekleyin. Paylaşmazsanız API 404 döner (403 değil), yani hata
# "database yok" gibi görünür.
NOTION_TOKEN=

# 📈 Trend Adayları database kimliği. Database URL'indeki 32 karakterlik
# kısım — https://notion.so/<workspace>/<BU_KISIM>?v=…
NOTION_TREND_DB=

# Yerel durum dizini (kota defteri, ileride trend zaman serisi).
# Boş bırakılırsa çalışma dizinindeki `veri/` kullanılır. Git'e girmez.
YT_OTOMASYON_VERI=

# DATABASE_URL=
# API_KEY=
