.claude/settings.local.json
# Ajanların açtığı git worktree'leri — makineye özel, paylaşılmaz.
.claude/worktrees/

# --- Editör / IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo

# --- Yerel not / plan dosyaları (uzun form doküman Notion'a gider) ---
*.local.md
NOTES.md
SCRATCH.md
.obsidian/

